      <column caption="Overall" datatype="integer" hidden="true" name="[Calculation_1116892761621487636]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF Month([UploadDate])= Month([Parameters].[Parameter 1]) OR &#13;&#10;Month([UploadDate])= Month([Parameters].[Parameter 1])-1 OR&#13;&#10;Month([UploadDate])= Month([Parameters].[Parameter 1])-2&#13;&#10;THEN  int([SiteCode]) &#13;&#10;&#13;&#10;ELSEIF Month([UploadDate])= Month([Parameters].[Parameter 1])-1 OR &#13;&#10;Month([UploadDate])= Month([Parameters].[Parameter 1])-2 OR&#13;&#10;Month([UploadDate])= Month([Parameters].[Parameter 1])-3&#13;&#10;THEN int([SiteCode]) &#13;&#10;&#13;&#10;&#13;&#10;END" />
      </column>
