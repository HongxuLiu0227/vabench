      <column caption="Upload Month Year - consistency" datatype="date" datatype-customized="true" default-format="*mmmm yyyy" name="[Calculation_989947529004945410]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="DATE(DATEPARSE ( &quot;HHmm-MM-dd yyyy&quot;, IF Month([UploadDate])=Month([Parameters].[Parameter 1]) AND Year([UploadDate])=Year([Parameters].[Parameter 1])&#13;&#10;OR (Day([UploadDate])&gt;=1 AND Day([UploadDate])&lt;=5 AND Month([UploadDate])=MONTH((Dateadd('month', 1, [Parameters].[Parameter 1])))&#13;&#10;AND Year([UploadDate])=Year([Parameters].[Parameter 1])) THEN STR(DATEADD('month',0, DATETRUNC('month',[Parameters].[Parameter 1])))+ &quot; &quot;+ STR(DATEPART('year', [Parameters].[Parameter 1]))&#13;&#10;&#13;&#10;ELSEIF (DATETRUNC('month',([UploadDate]))= DATEADD('month',-1, DATETRUNC('month',[Parameters].[Parameter 1]))&#13;&#10;OR (Day([UploadDate])&gt;=1 AND Day([UploadDate])&lt;=5&#13;&#10;AND Month([UploadDate])=MONTH((Dateadd('month', 0, [Parameters].[Parameter 1])))&#13;&#10;AND Year([UploadDate])=Year([Parameters].[Parameter 1]))&#13;&#10;)&#13;&#10;THEN STR(DATEADD('month',-1, DATETRUNC('month',[Parameters].[Parameter 1])))+ &quot; &quot;+ STR(DATEPART('year', [Parameters].[Parameter 1]))&#13;&#10;&#13;&#10;ELSEIF(&#13;&#10;DATETRUNC('month',([UploadDate]))=&#13;&#10;DATEADD('month',-2, DATETRUNC('month',[Parameters].[Parameter 1])&#13;&#10;)&#13;&#10;OR &#13;&#10;(Day([UploadDate])&gt;=1 AND Day([UploadDate])&lt;=5&#13;&#10;AND Month([UploadDate])=MONTH((Dateadd('month', -1, [Parameters].[Parameter 1])))&#13;&#10;AND Year([UploadDate])=Year([Parameters].[Parameter 1]))&#13;&#10;)&#13;&#10;THEN STR(DATEADD('month',-2, DATETRUNC('month',[Parameters].[Parameter 1])))+ &quot; &quot;+ STR(DATEPART('year', [Parameters].[Parameter 1]))&#13;&#10; END )) " />
      </column>
      <column caption="Consistency at Site Level" datatype="string" hidden="true" name="[Consistency (copy)]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF {Fixed [DisplayMechanism],[UploadDate],[SiteCode]: Count([SiteCode])}&#13;&#10;%3 = 0 THEN 'Concist' ELSE 'NO' END" />
      </column>
      <column caption="County -test" datatype="string" hidden="true" name="[County - Uploads Score (copy)]" role="measure" semantic-role="[County].[Name]" type="nominal">
        <calculation class="tableau" formula="IF  [Calculation_714102023265861635] &gt;=0.67 THEN 'Good'&#13;&#10;ELSEIF  [Calculation_714102023265861635]&gt;=0.34 AND [Calculation_714102023265861635]&lt;0.67 &#13;&#10;THEN 'Average'&#13;&#10;ELSE 'Bad' END" />
      </column>
      <column caption="County Color MPI" datatype="string" name="[County Color (copy 2)]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF ([County Percent Uploads Proportions (copy 3)]&gt;=0.67)THEN 'Above 67%'&#13;&#10;ELSEIF ([County Percent Uploads Proportions (copy 3)]&lt;0.67 &#13;&#10;AND [County Percent Uploads Proportions (copy 3)]&gt;=0.34)&#13;&#10; THEN '34 - 66%'&#13;&#10;ELSE 'Below 34%'&#13;&#10;END" />
      </column>
      <column caption="PArtner Color " datatype="string" name="[County Color (copy)]" role="measure" semantic-role="[County].[Name]" type="nominal">
        <calculation class="tableau" formula="IF ([County Percent Uploads Proportions (copy)]&gt;=0.67)THEN 'Above 67%'&#13;&#10;ELSEIF ([County Percent Uploads Proportions (copy)]&lt;0.67 AND [County Percent Uploads Proportions (copy)]&gt;=0.34)&#13;&#10; THEN '34 - 66%'&#13;&#10;ELSE 'Below 33%'&#13;&#10;END" />
      </column>
