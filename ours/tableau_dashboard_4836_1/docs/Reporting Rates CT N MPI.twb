      </column>
      <column caption="Upload Score Partner" datatype="string" hidden="true" name="[Calculation_1301540307376828426]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF Day([UploadDate]) &gt;=1 AND Day([UploadDate]) &lt;=10  THEN 'On Time'&#13;&#10;ELSEIF  Day([UploadDate]) &gt;=11 AND Day([UploadDate]) &lt;=31 THEN 'Delayed'&#13;&#10;ELSE 'Not Reported' END" />
      </column>
      <column caption="County - Uploads Score" datatype="string" name="[Calculation_1301540307486310419]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF  [Calculation_714102023265861635] &gt;=0.67 THEN 'Good (Above 67%)'&#13;&#10;ELSEIF  [Calculation_714102023265861635]&gt;=0.34 AND [Calculation_714102023265861635]&lt;0.67 &#13;&#10;THEN 'Average (34-66%)'&#13;&#10;ELSE 'Bad (Below 33%)' END" />
      </column>
      <column caption="Number of EMR Sites (DisplayMFL)" datatype="integer" hidden="true" name="[Calculation_1308014242145460225]" role="measure" type="quantitative">
        <calculation class="tableau" formula="CountD([DisplayMFL])" />
      </column>
      <column caption="This Quarter Label" datatype="string" hidden="true" name="[Calculation_1308014242151911426]" role="dimension" type="nominal">
        <calculation class="tableau" formula="DateName('month', (Dateadd('month', 1, DATETRUNC('quarter',Today()))-1) ) + '-'&#13;&#10;+ DateName('month', (Dateadd('month', 2, DATETRUNC('quarter',Today()))+1))+&#13;&#10;' ' +STR(YEAR(Today()))" />
      </column>
      <column caption="Upload Month/Year Str" datatype="string" name="[Calculation_1593429869208784896]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF ISNULL([Upload Month / Year]) THEN 'Never Uploaded' ELSE STR(DATENAME('month', [UploadDate]))+ &quot; &quot;+&#13;&#10;STR(DATEPART('year', [UploadDate])) END" />
      </column>
      <column caption="Recency of Uploads" datatype="string" name="[Calculation_1593429869216702466]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF DATEDIFF('month',[Siteabstractiondate],[Calculation_1593429869225746435])=1 OR DATEDIFF('month',[Siteabstractiondate],[Calculation_1593429869225746435])=-1 THEN  &#13;&#10;STR(DATEDIFF('month',[Siteabstractiondate],[Calculation_1593429869225746435]))+ ' month'&#13;&#10;ELSEIF ISNULL(STR(DATEDIFF('month',[Siteabstractiondate],[Calculation_1593429869225746435]))) THEN 'Never Uploaded'&#13;&#10;ELSE&#13;&#10;STR(DATEDIFF('month',[Siteabstractiondate],[Calculation_1593429869225746435])) + ' months'&#13;&#10;END" />
      </column>
      <column caption="Max Upload Date" datatype="date" name="[Calculation_1593429869225746435]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="{Fixed [DisplayMFL]: MAx([UploadDate])}" />
      </column>
      <column caption="Recency Color " datatype="string" name="[Calculation_1593429869238980612]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [Calculation_1593429869216702466] = 'Never Uploaded' OR Contains(STR(DATEDIFF('month',[Siteabstractiondate],[Calculation_1593429869225746435])),'-')&#13;&#10;THEN 'Bad'&#13;&#10;ELSEIF STR(DATEDIFF('month',[Siteabstractiondate],[Calculation_1593429869225746435])) ='0' &#13;&#10;OR &#13;&#10;STR(DATEDIFF('month',[Siteabstractiondate],[Calculation_1593429869225746435])) ='1'&#13;&#10;OR &#13;&#10;STR(DATEDIFF('month',[Siteabstractiondate],[Calculation_1593429869225746435])) ='2'&#13;&#10;THEN 'Good'&#13;&#10;ELSE 'Average' END" />
      </column>
      <column caption="Latest CT Upload" datatype="string" datatype-customized="true" name="[Calculation_1593429869476466693]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF ISNULL(STR({Fixed [DisplayFacilityName]: Max([UploadDate])})) THEN 'Never Uploaded' &#13;&#10;ELSE STR({Fixed [DisplayFacilityName]: Max([UploadDate])})&#13;&#10;END" />
      </column>
      <column caption="Upload Status - Calc" datatype="string" name="[Calculation_1593429869478662153]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF STR(DATENAME('month', [Calculation_1593429869225746435]))+ &quot; &quot;+ STR(DATEPART('year', [Calculation_1593429869225746435])) = STR(DATENAME('month', [Calculation_1593429869478948874] ))+ &quot; &quot;+&#13;&#10;STR(DATEPART('year', [Calculation_1593429869478948874])) AND &#13;&#10;STR(DATENAME('month', [Calculation_1593429869225746435]))+ &quot; &quot;+ STR(DATEPART('year', [Calculation_1593429869225746435])) = STR(DATENAME('month', Today() ))+ &quot; &quot;+&#13;&#10;STR(DATEPART('year', Today()))&#13;&#10;AND &#13;&#10;STR(DATENAME('month', [Calculation_1593429869478948874]))+ &quot; &quot;+ STR(DATEPART('year', [Calculation_1593429869478948874])) = STR(DATENAME('month', Today() ))+ &quot; &quot;+&#13;&#10;STR(DATEPART('year', Today()))&#13;&#10;THEN 'CT &amp; PKVs Uploaded'&#13;&#10;ELSEIF STR(DATENAME('month', [Calculation_1593429869225746435]))+ &quot; &quot;+ STR(DATEPART('year', [Calculation_1593429869225746435])) &lt; STR(DATENAME('month', [Calculation_1593429869478948874] ))+ &quot; &quot;+&#13;&#10;STR(DATEPART('year', [Calculation_1593429869478948874])) &#13;&#10;AND&#13;&#10;STR(DATENAME('month', [Calculation_1593429869225746435]))+ &quot; &quot;+ STR(DATEPART('year', [Calculation_1593429869225746435])) = STR(DATENAME('month', Today() ))+ &quot; &quot;+&#13;&#10;STR(DATEPART('year', Today()))&#13;&#10;THEN 'Latest CT Only Uploaded, PKVs Stale'&#13;&#10;ELSEIF  ISNULL([Calculation_1593429869478948874]) AND NOT ISNULL([Calculation_1593429869225746435]) &#13;&#10;AND STR(DATENAME('month', [Calculation_1593429869225746435]))+ &quot; &quot;+ STR(DATEPART('year', [Calculation_1593429869225746435])) = STR(DATENAME('month', Today() ))+ &quot; &quot;+&#13;&#10;STR(DATEPART('year', Today())) THEN 'Only CT Uploaded; No PKVs'&#13;&#10;ELSEIF  ISNULL([Calculation_1593429869225746435]) AND NOT ISNULL([Calculation_1593429869478948874]) &#13;&#10;AND&#13;&#10;STR(DATENAME('month', [Calculation_1593429869478948874]))+ &quot; &quot;+ STR(DATEPART('year', [Calculation_1593429869478948874])) = STR(DATENAME('month', Today() ))+ &quot; &quot;+&#13;&#10;STR(DATEPART('year', Today()))&#13;&#10; THEN 'Only PKVs Uploaded'&#13;&#10;ELSEIF  ISNULL([Calculation_1593429869225746435])&#13;&#10;THEN 'Never Uploaded to DWH'&#13;&#10;ELSE 'Not Uploaded this month'&#13;&#10;END" />
      </column>
      <column caption="Max MPI Upload Date" datatype="date" name="[Calculation_1593429869478948874]" role="dimension" type="ordinal">
