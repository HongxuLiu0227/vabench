              <calculation class="tableau" formula="IF ATTR([DisplayMechanism]) = ATTR([DisplayMechanism]) AND ATTR([DisplayCounty])!=ATTR([DisplayCounty]) AND ATTR([DisplayFacilityName]) = ATTR([DisplayFacilityName]) THEN &#13;&#10;ATTR([DisplayMechanism])&#13;&#10;ELSEIF ATTR([DisplayCounty])=ATTR([DisplayCounty]) THEN &#13;&#10;ATTR([DisplayCounty])&#13;&#10;ELSEIF ATTR([DisplayFacilityName]) = ATTR([DisplayFacilityName]) THEN&#13;&#10;ATTR([DisplayFacilityName])&#13;&#10;ELSEIF ATTR([DisplayMechanism]) = ATTR([DisplayMechanism]) AND ATTR([DisplayCounty])=ATTR([DisplayCounty]) THEN &#13;&#10;ATTR([DisplayMechanism])+' '+ ATTR([DisplayCounty])&#13;&#10;ELSE ''&#13;&#10;END" />
