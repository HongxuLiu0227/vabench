      <datasource-dependencies datasource="Parameters">
        <column caption="Upload Period - 3 Months" datatype="date" datatype-customized="true" default-format="*mmmm, yyyy" name="[Parameter 1]" param-domain-type="list" role="measure" type="quantitative" value="#2021-01-06#">
          <calculation class="tableau" formula="#2021-01-06#" />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption="Migrated Data" id="Migrated Data">
            <properties context="">
              <relation connection="sqlserver.19t3d0l0dv4uus1ckysq314txqb5" name="Custom SQL Query" type="text">SELECT DISTINCT
ISNULL (A.MFLCode, B.SiteCode) as DisplayMFL, 
ISNULL (A.FacilityName, B.Name) as DisplayFacilityName,
A.Sub_County as DisplaySubcounty,
Upper(A.County) as DisplayCounty, 
Upper(A.CTPartner) as DisplayMechanism,
Upper(ISNULL (A.CTAgency, B.Agency)) as DisplayAgency,
CASE WHEN Upload_monthYear=Upload_monthYear_MPI  THEN 'Both Care &amp; Treatment + PKV(MPI) uploaded'
	WHEN Upload_monthYear IS NOT NULL AND Upload_monthYear_MPI IS NULL THEN 'Only Care &amp; Treatment Uploaded'
	WHEN Upload_monthYear IS NULL AND Upload_monthYear_MPI IS NOT NULL THEN 'Only PKV(MPI) Uploaded'
	ELSE 'Not Uploaded Care &amp; Treatment or PKV(MPI)' END AS UploadStatus,
UploadDate,
Upload_monthYear,
B.SiteCode,
MPI_SiteCode,
UploadDate_MPI,
Upload_monthYear_MPI,
computedAbstraction as Siteabstractiondate
FROM 
(
Select Distinct es.* from [HIS_Implementation].dbo.[EMRSites] es
) A
LEFT JOIN (
SELECT UploadDate, UploadDate_MPI,MPI_SiteCode,SiteCode,Name,CTAgency as Agency,Upload_monthYear,Upload_monthYear_MPI FROM  (
Select * from (
SELECT Distinct cast([SiteCode] as Varchar(100)) SiteCode,CAST(ROW_NUMBER ( ) OVER (PARTITION BY SiteCode,Concat(DateName(Month,(DATEADD(mm, DATEDIFF(mm, 0, DateRecieved), 0))),' ', Year(DateRecieved)) ORDER BY Max(cast(DateRecieved as date)) asc) AS Varchar) AS RowID,
Concat(DateName(Month,(DATEADD(mm, DATEDIFF(mm, 0, DateRecieved), 0))),' ', Year(DateRecieved))Upload_monthYear,
Max(cast(DateRecieved as date)) UploadDate, 
F.FacilityName as Name,U.CTAgency
FROM [DWAPICentral].[dbo].[FacilityManifest] C
inner join [DWAPICentral].[dbo].Facility D on C.SiteCode = D.Code
inner join [DWAPICentral].[dbo].FacilityInfo E on E.FacilityId = D.id 
left join [HIS_Implementation].dbo.EMRSites U on C.SiteCode= U.MFLCode
left join All_Staging_2016_2.dbo.DimFacilities f on f.FacilityCode=C.SiteCode
Where DateDiff(mm,DateRecieved, Getdate())&lt;&lt;=12 and D.voided =0
group by [SiteCode],DateRecieved,F.FacilityName ,E.County,E.Mechanism, U.CTAgency
)c
WHere RowID=1
) AS CT

LEFT JOIN 
(
Select * from (
SELECT Distinct cast(C.[SiteCode] as Varchar(100)) AS MPI_SiteCode,CAST(ROW_NUMBER ( ) OVER (PARTITION BY C.SiteCode,Concat(DateName(Month,(DATEADD(mm, DATEDIFF(mm, 0, DateArrived), 0))),' ', Year(DateArrived)) ORDER BY Max(cast(DateArrived as date)) asc) AS Varchar) AS RowID_MPI,
Concat(DateName(Month,(DATEADD(mm, DATEDIFF(mm, 0, DateArrived), 0))),' ', Year(DateArrived))Upload_monthYear_MPI,
Max(cast(DateArrived as date)) UploadDate_MPI
FROM CBSCentral.[dbo].[Manifests] C
inner join CBSCentral.[dbo].Facilities D on C.SiteCode = D.SiteCode
inner join CBSCentral.[dbo].MasterFacilities E on E.Id = D.SiteCode 
left join [HIS_Implementation].dbo.EMRSites U on C.SiteCode= U.MFLCode
Where DateDiff(mm,DateArrived, Getdate())&lt;&lt;=12 
group by C.[SiteCode],DateArrived
)c WHere RowID_MPI=1
   )AS MPI   ON CT.SiteCode=MPI.MPI_SiteCode AND CT.Upload_monthYear=MPI.Upload_monthYear_MPI
) AS B

ON A.MFLCode = B.SiteCode
LEFT JOIN (
Select Distinct Sitecode,SiteabstractionDate,h.CreatedDate,Case when SiteabstractionDate &gt;&gt; h.CreatedDate THEN h.CreatedDate ELSE SiteabstractionDate END AS computedAbstraction
from All_Staging_2016_2.dbo.lkp_SiteAbstractionDate l
inner join (
Select Max(cast(p.Created as date)) as CreatedDate,f.Code from DWAPICentral.dbo.PatientExtract p
inner join DWAPICentral.dbo.facility f on f.id=p.Facilityid
group by f.Code) h on h.Code=l.Sitecode
Where Sitecode&gt;&gt;1
) V on v.Sitecode=B.SiteCode</relation>
            </properties>
            <properties context="extract">
              <relation name="Extract" table="[Extract].[Extract]" type="table" />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
