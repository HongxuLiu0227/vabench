  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Tourism In Canada - What Provinces have the highest growth rates from 2014-17? Where do most of the tourists originate from in BC?'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Tourism In Canada - Provinicial Tourism Demand Growth Rates (2014-17) &amp; Tourist Demand Origins</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='dash-title'>
          <format attr='color' value='#59a14f' />
          <format attr='font-weight' value='bold' />
          <format attr='background-color' value='#f7faf0' />
        </style-rule>
      </style>
      <size sizing-mode='automatic' />
      <datasources>
        <datasource caption='df' name='federated.1jxzz030pj39fl1gdog6e0w941ap' />
      </datasources>
      <datasource-dependencies datasource='federated.1jxzz030pj39fl1gdog6e0w941ap'>
        <column datatype='string' name='[Location (group) 1]' role='dimension' type='nominal'>
          <calculation class='categorical-bin' column='[Location]' default='&quot;Other&quot;' new-bin='true'>
            <bin default-name='true' value='&quot;Alberta&quot;'>
              <value>&quot;Alberta&quot;</value>
            </bin>
            <bin default-name='true' value='&quot;British Columbia&quot;'>
              <value>&quot;British Columbia&quot;</value>
            </bin>
            <bin default-name='true' value='&quot;Ontario&quot;'>
              <value>&quot;Ontario&quot;</value>
            </bin>
            <bin default-name='true' value='&quot;Quebec&quot;'>
              <value>&quot;Quebec&quot;</value>
            </bin>
          </calculation>
        </column>
        <column datatype='string' name='[Location]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97448' id='14' param='vert' type-v2='layout-flow' w='98666' x='667' y='1276'>
