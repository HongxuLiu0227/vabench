    <worksheet name="Sheet 28">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor="#0b2255">Effect of Light condition, Speed and Weather on Number of Accidents</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="DfTRoadSafety_Accidents_2014" name="textscan.1ats9d2064dxax15btitd1ugifpt" />
          </datasources>
          <datasource-dependencies datasource="textscan.1ats9d2064dxax15btitd1ugifpt">
            <column datatype="string" name="[Light Conditions (group)]" role="dimension" type="nominal">
              <calculation class="categorical-bin" column="[Light_Conditions]" />
            </column>
            <column caption="Light Conditions" datatype="string" name="[Light_Conditions]" role="dimension" type="nominal">
              <aliases>
                <alias key="&quot;1&quot;" value="Daylight" />
                <alias key="&quot;4&quot;" value="Darkness - lights lit" />
                <alias key="&quot;5&quot;" value="Darkness - light unlit" />
                <alias key="&quot;6&quot;" value="Darkness - No lighting" />
                <alias key="&quot;7&quot;" value="Darkness - Lighting Unknown" />
              </aliases>
            </column>
            <column caption="Number of Accidents" datatype="integer" name="[Number of Records]" role="measure" type="quantitative" user:auto-column="numrec">
              <calculation class="tableau" formula="1" />
            </column>
            <column caption="Road Surface Conditions" datatype="string" name="[Road_Surface_Conditions]" role="dimension" type="nominal">
              <aliases>
                <alias key="&quot;-1&quot;" value="Data Missing" />
                <alias key="&quot;1&quot;" value="Dry" />
                <alias key="&quot;2&quot;" value="Wet or Damp" />
                <alias key="&quot;3&quot;" value="Snow" />
                <alias key="&quot;4&quot;" value="Frost or Ice" />
                <alias key="&quot;5&quot;" value="Flood over 3cm deep" />
              </aliases>
            </column>
            <column caption="Speed limit" datatype="string" name="[Speed_limit]" role="dimension" type="nominal" />
            <column caption="Weather Conditions" datatype="string" name="[Weather_Conditions]" role="dimension" type="nominal">
              <aliases>
                <alias key="&quot;1&quot;" value="Fine No High winds" />
                <alias key="&quot;2&quot;" value="Raining No High winds" />
                <alias key="&quot;3&quot;" value="Snowing no high winds" />
                <alias key="&quot;4&quot;" value="Fine + high winds" />
                <alias key="&quot;5&quot;" value="Raining + high winds" />
                <alias key="&quot;6&quot;" value="Snowing + high winds" />
                <alias key="&quot;7&quot;" value="Fog or mist" />
                <alias key="&quot;8&quot;" value="Other" />
                <alias key="&quot;9&quot;" value="Unknown" />
              </aliases>
            </column>
            <column-instance column="[Speed_limit]" derivation="None" name="[none:Speed_limit:nk]" pivot="key" type="nominal" />
            <column-instance column="[Weather_Conditions]" derivation="None" name="[none:Weather_Conditions:nk]" pivot="key" type="nominal" />
            <column-instance column="[Number of Records]" derivation="Sum" name="[sum:Number of Records:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="categorical" column="[textscan.1ats9d2064dxax15btitd1ugifpt].[Action (Light Conditions (group),Weather Conditions)]">
            <groupfilter function="crossjoin" user:ui-enumeration="all" user:ui-marker="enumerate">
              <groupfilter function="level-members" level="[Light Conditions (group)]" />
              <groupfilter function="level-members" level="[Weather_Conditions]" />
            </groupfilter>
          </filter>
          <filter class="categorical" column="[textscan.1ats9d2064dxax15btitd1ugifpt].[Action (Road Surface Conditions,Weather Conditions)]">
            <groupfilter function="crossjoin" user:ui-enumeration="all" user:ui-marker="enumerate">
              <groupfilter function="level-members" level="[Road_Surface_Conditions]" />
              <groupfilter function="level-members" level="[Weather_Conditions]" />
