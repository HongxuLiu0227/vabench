      <column caption='MAE Liner Pred' datatype='real' name='[Calculation_1057431142530928640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='abs([Calculation_94857087533387778]-[Linear Preds])' />
      </column>
      <column caption='Solid/Non Solid' datatype='string' name='[Calculation_94857087532371968]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Solid_Flag.Non.Solid] = 1 THEN&#10;&apos;Non-Solid&apos;&#10;ELSE &apos;Solid&apos;&#10;END' />
      </column>
      <column caption='Clusters' datatype='string' name='[Calculation_94857087532646401]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [cluster.1] = 1 THEN&#10;&apos;Cluster-1&apos;&#10;ELSEIF [cluster.2] = 1 THEN&#10;&apos;Cluster-2&apos;&#10;ELSE &apos;Cluster-3&apos;&#10;END' />
      </column>
      <column caption='Observed' datatype='real' name='[Calculation_94857087533387778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='EXP([CumulativeUnits])' />
      </column>
      <column caption='Model Parameter' datatype='real' name='[Calculation_94857087533715459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Linear Regression&apos; &#10;AND [Parameters].[Parameter 1] = &apos;Test Accuracy&apos; THEN&#10;[Linear Preds]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Decision Tree&apos; &#10;AND [Parameters].[Parameter 1] = &apos;Test Accuracy&apos; THEN&#10;[Bagging Preds]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Random Forest &apos;  &#10;AND [Parameters].[Parameter 1] = &apos;Test Accuracy&apos; THEN&#10;[Randomforest Preds]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;XGBoost&apos; &#10;AND [Parameters].[Parameter 1] = &apos;Test Accuracy&apos; THEN&#10;[XGBoost Preds]&#10;END' />
      </column>
      <column caption='Color - MAE' datatype='string' name='[Calculation_94857087539785733]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Model Parameter (copy)_94857087534559236] &lt; 150 THEN &#10;&apos;Low Variance&apos;&#10;ELSEIF [Model Parameter (copy)_94857087534559236] &lt; 280 THEN&#10;&apos;Medium Variance&apos;&#10;ELSE &apos;High Variance&apos;&#10;END' />
      </column>
      <column caption='Cumulative Units' datatype='real' name='[CumulativeUnits]' role='measure' type='quantitative' />
