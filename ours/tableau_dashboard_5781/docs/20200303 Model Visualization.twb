      <column caption='LaunchDate ID' datatype='date' name='[LaunchDate_ID]' role='dimension' type='ordinal' />
      <column caption='MAE Randomforest Pred ' datatype='real' name='[MAE Decision Pred (copy)_1057431142531837955]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='abs([Calculation_94857087533387778]- [Randomforest Preds])' />
