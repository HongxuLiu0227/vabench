{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "lib": ["ES2023"],
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./scripts",
    "rootDir": "./scripts"
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "src"]
}
