      <column caption="Pecentile of Average Medicare Coverage" datatype="real" name="[Calculation_945755973517197313]" role="measure" type="quantitative">
        <calculation class="tableau" formula="AVG([Average Medicare Payments]/[Average Total Payments ])" />
      </column>
