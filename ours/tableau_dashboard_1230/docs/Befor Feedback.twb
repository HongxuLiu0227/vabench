  <dashboards>
    <dashboard name='Before Feedback Analysis/Story' type='storyboard'>
      <repository-location derived-from='https://public.tableau.com/workbooks/MadeWithUdacity/BeforeFeedbackAnalysisStory?rev=' id='BeforeFeedbackAnalysisStory' path='/workbooks/BeforFeedback' revision='' />
      <style>
