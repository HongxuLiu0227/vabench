        <groupfilter function='crossjoin'>
          <groupfilter function='level-members' level='[Genre]' />
        </groupfilter>
      </group>
      <group caption='Action (Genre,Name,Publisher)' hidden='true' name='[Action (Genre,Name,Publisher)]' name-style='unqualified' user:auto-column='sheet_link'>
