      <column caption='Facility Const' datatype='string' hidden='true' name='[Calculation_956452015755472904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF (Month([UploadDate])=Month([Parameters].[Parameter 1])&#13;&#10;AND Month([UploadDate])=Month([Parameters].[Parameter 1])-1&#13;&#10;AND Month([UploadDate])=Month([Parameters].[Parameter 1])-2)&#13;&#10;THEN &apos;consistent&apos;&#13;&#10;ELSE &apos;no consitent&apos;&#13;&#10;END' />
