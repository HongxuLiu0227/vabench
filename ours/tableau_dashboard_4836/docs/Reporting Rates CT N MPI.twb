      </column>
      <column datatype='integer' name='[Upload Month / Year]' role='dimension' type='ordinal' user:agg-type='MY' user:base-field='UploadDate' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='(DATEPART(&apos;year&apos;, [UploadDate])*100 + DATEPART(&apos;month&apos;, [UploadDate]))' />
      </column>
      <column datatype='integer' hidden='true' name='[Upload Month Date]' role='dimension' type='ordinal' user:agg-type='Month' user:base-field='UploadDate' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='DATEPART(&apos;month&apos;, [UploadDate])' />
      </column>
      <column caption='Timeliness Upload' datatype='string' hidden='true' name='[Upload Score Partner (copy 3)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF Day([UploadDate]) &gt;=1 AND Day([UploadDate]) &lt;=10  THEN &apos;Timely&apos;&#13;&#10;ELSEIF  Day([UploadDate]) &gt;10 AND Day([UploadDate]) &lt;=31 THEN &apos;Sent Late&apos;&#13;&#10;ELSE &apos;Not Sent&apos; END' />
