        <calculation class='tableau' formula='IF (month([Calculation_766737854778548226]) =1 AND (Dateadd(&apos;month&apos;, -1, [Parameters].[Parameter 1]) &lt;Today())) THEN &#13;&#10;DateName(&apos;month&apos;, (Dateadd(&apos;month&apos;, -1, [Parameters].[Parameter 1])))+&#13;&#10;&apos; &apos; +STR(YEAR([Parameters].[Parameter 1])-1)&#13;&#10;ELSE &#13;&#10;DateName(&apos;month&apos;, (Dateadd(&apos;month&apos;, -1, [Parameters].[Parameter 1])))+&#13;&#10;&apos; &apos; +STR(YEAR([Parameters].[Parameter 1]))&#13;&#10;END' />
