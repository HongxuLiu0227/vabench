      <column caption='Overall reporting Rate' datatype='string' hidden='true' name='[Calculation_790100288080109568]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF (Month([UploadDate])=Month([Parameters].[Parameter 1])&#13;&#10;OR&#13;&#10;DATETRUNC(&apos;month&apos;,([UploadDate]))=&#13;&#10;DATEADD(&apos;month&apos;,-1, DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])&#13;&#10;)&#13;&#10;OR&#13;&#10;DATETRUNC(&apos;month&apos;,([UploadDate]))=&#13;&#10;DATEADD(&apos;month&apos;,-2, DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])&#13;&#10;)) THEN [DisplayFacilityName] END' />
      </column>
      <column caption='Date Filter' datatype='integer' hidden='true' name='[Calculation_956452015702589443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Upload Month / Year]' />
      </column>
      <column caption='Upload MONTH YEAR' datatype='string' hidden='true' name='[Calculation_956452015702814724]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATENAME(&apos;month&apos;, [UploadDate]))+ &quot; &quot;+&#13;&#10;STR(DATEPART(&apos;year&apos;, [UploadDate]))' />
