      <repository-location derived-from='https://data.kenyahmis.org/t/NASCOPCOHORT2016/workbooks/ReportingRatesCTNMPI/SummaryStats?rev=' id='SummaryStats' path='/t/NASCOPCOHORT2016/workbooks/ReportingRatesCTNMPI' revision='' site='NASCOPCOHORT2016' />
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (Multiple Connections)' name='federated.0se4v9q15j8hfi17f25m50pn59wd' />
          </datasources>
          <datasource-dependencies datasource='federated.0se4v9q15j8hfi17f25m50pn59wd'>
            <column caption='Max Upload Date' datatype='date' name='[Calculation_1593429869225746435]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Fixed [DisplayMFL]: MAx([UploadDate])}' />
            </column>
            <column caption='Upload Status - Calc' datatype='string' name='[Calculation_1593429869478662153]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STR(DATENAME(&apos;month&apos;, [Calculation_1593429869225746435]))+ &quot; &quot;+ STR(DATEPART(&apos;year&apos;, [Calculation_1593429869225746435])) = STR(DATENAME(&apos;month&apos;, [Calculation_1593429869478948874] ))+ &quot; &quot;+&#13;&#10;STR(DATEPART(&apos;year&apos;, [Calculation_1593429869478948874])) AND &#13;&#10;STR(DATENAME(&apos;month&apos;, [Calculation_1593429869225746435]))+ &quot; &quot;+ STR(DATEPART(&apos;year&apos;, [Calculation_1593429869225746435])) = STR(DATENAME(&apos;month&apos;, Today() ))+ &quot; &quot;+&#13;&#10;STR(DATEPART(&apos;year&apos;, Today()))&#13;&#10;AND &#13;&#10;STR(DATENAME(&apos;month&apos;, [Calculation_1593429869478948874]))+ &quot; &quot;+ STR(DATEPART(&apos;year&apos;, [Calculation_1593429869478948874])) = STR(DATENAME(&apos;month&apos;, Today() ))+ &quot; &quot;+&#13;&#10;STR(DATEPART(&apos;year&apos;, Today()))&#13;&#10;THEN &apos;CT &amp; PKVs Uploaded&apos;&#13;&#10;ELSEIF STR(DATENAME(&apos;month&apos;, [Calculation_1593429869225746435]))+ &quot; &quot;+ STR(DATEPART(&apos;year&apos;, [Calculation_1593429869225746435])) &lt; STR(DATENAME(&apos;month&apos;, [Calculation_1593429869478948874] ))+ &quot; &quot;+&#13;&#10;STR(DATEPART(&apos;year&apos;, [Calculation_1593429869478948874])) &#13;&#10;AND&#13;&#10;STR(DATENAME(&apos;month&apos;, [Calculation_1593429869225746435]))+ &quot; &quot;+ STR(DATEPART(&apos;year&apos;, [Calculation_1593429869225746435])) = STR(DATENAME(&apos;month&apos;, Today() ))+ &quot; &quot;+&#13;&#10;STR(DATEPART(&apos;year&apos;, Today()))&#13;&#10;THEN &apos;Latest CT Only Uploaded, PKVs Stale&apos;&#13;&#10;ELSEIF  ISNULL([Calculation_1593429869478948874]) AND NOT ISNULL([Calculation_1593429869225746435]) &#13;&#10;AND STR(DATENAME(&apos;month&apos;, [Calculation_1593429869225746435]))+ &quot; &quot;+ STR(DATEPART(&apos;year&apos;, [Calculation_1593429869225746435])) = STR(DATENAME(&apos;month&apos;, Today() ))+ &quot; &quot;+&#13;&#10;STR(DATEPART(&apos;year&apos;, Today())) THEN &apos;Only CT Uploaded; No PKVs&apos;&#13;&#10;ELSEIF  ISNULL([Calculation_1593429869225746435]) AND NOT ISNULL([Calculation_1593429869478948874]) &#13;&#10;AND&#13;&#10;STR(DATENAME(&apos;month&apos;, [Calculation_1593429869478948874]))+ &quot; &quot;+ STR(DATEPART(&apos;year&apos;, [Calculation_1593429869478948874])) = STR(DATENAME(&apos;month&apos;, Today() ))+ &quot; &quot;+&#13;&#10;STR(DATEPART(&apos;year&apos;, Today()))&#13;&#10; THEN &apos;Only PKVs Uploaded&apos;&#13;&#10;ELSEIF  ISNULL([Calculation_1593429869225746435])&#13;&#10;THEN &apos;Never Uploaded to DWH&apos;&#13;&#10;ELSE &apos;Not Uploaded this month&apos;&#13;&#10;END' />
            </column>
            <column caption='Max MPI Upload Date' datatype='date' name='[Calculation_1593429869478948874]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [DisplayFacilityName]: Max([UploadDate_MPI])}' />
            </column>
            <column caption='Label Summary' datatype='string' name='[Calculation_1593429869496758285]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([DisplayMechanism]) = ATTR([DisplayMechanism]) AND ATTR([DisplayCounty])!=ATTR([DisplayCounty]) AND ATTR([DisplayFacilityName]) = ATTR([DisplayFacilityName]) THEN &#13;&#10;ATTR([DisplayMechanism])&#13;&#10;ELSEIF ATTR([DisplayCounty])=ATTR([DisplayCounty]) THEN &#13;&#10;ATTR([DisplayCounty])&#13;&#10;ELSEIF ATTR([DisplayFacilityName]) = ATTR([DisplayFacilityName]) THEN&#13;&#10;ATTR([DisplayFacilityName])&#13;&#10;ELSEIF ATTR([DisplayMechanism]) = ATTR([DisplayMechanism]) AND ATTR([DisplayCounty])=ATTR([DisplayCounty]) THEN &#13;&#10;ATTR([DisplayMechanism])+&apos; &apos;+ ATTR([DisplayCounty])&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='County' datatype='string' name='[DisplayCounty]' role='dimension' semantic-role='[State].[Name]' type='nominal'>
              <aliases>
                <alias key='&quot;Elegeyo-Marakwet&quot;' value='Elgeyo Marakwet' />
