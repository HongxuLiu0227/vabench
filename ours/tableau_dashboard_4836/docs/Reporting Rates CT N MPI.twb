      </column>
      <column caption='Upload Score Partner' datatype='string' hidden='true' name='[Calculation_1301540307376828426]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF Day([UploadDate]) &gt;=1 AND Day([UploadDate]) &lt;=10  THEN &apos;On Time&apos;&#13;&#10;ELSEIF  Day([UploadDate]) &gt;=11 AND Day([UploadDate]) &lt;=31 THEN &apos;Delayed&apos;&#13;&#10;ELSE &apos;Not Reported&apos; END' />
      </column>
      <column caption='County - Uploads Score' datatype='string' name='[Calculation_1301540307486310419]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF  [Calculation_714102023265861635] &gt;=0.67 THEN &apos;Good (Above 67%)&apos;&#13;&#10;ELSEIF  [Calculation_714102023265861635]&gt;=0.34 AND [Calculation_714102023265861635]&lt;0.67 &#13;&#10;THEN &apos;Average (34-66%)&apos;&#13;&#10;ELSE &apos;Bad (Below 33%)&apos; END' />
      </column>
      <column caption='Number of EMR Sites (DisplayMFL)' datatype='integer' hidden='true' name='[Calculation_1308014242145460225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CountD([DisplayMFL])' />
      </column>
      <column caption='This Quarter Label' datatype='string' hidden='true' name='[Calculation_1308014242151911426]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DateName(&apos;month&apos;, (Dateadd(&apos;month&apos;, 1, DATETRUNC(&apos;quarter&apos;,Today()))-1) ) + &apos;-&apos;&#13;&#10;+ DateName(&apos;month&apos;, (Dateadd(&apos;month&apos;, 2, DATETRUNC(&apos;quarter&apos;,Today()))+1))+&#13;&#10;&apos; &apos; +STR(YEAR(Today()))' />
      </column>
      <column caption='Upload Month/Year Str' datatype='string' name='[Calculation_1593429869208784896]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Upload Month / Year]) THEN &apos;Never Uploaded&apos; ELSE STR(DATENAME(&apos;month&apos;, [UploadDate]))+ &quot; &quot;+&#13;&#10;STR(DATEPART(&apos;year&apos;, [UploadDate])) END' />
      </column>
      <column caption='Recency of Uploads' datatype='string' name='[Calculation_1593429869216702466]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;month&apos;,[Siteabstractiondate],[Calculation_1593429869225746435])=1 OR DATEDIFF(&apos;month&apos;,[Siteabstractiondate],[Calculation_1593429869225746435])=-1 THEN  &#13;&#10;STR(DATEDIFF(&apos;month&apos;,[Siteabstractiondate],[Calculation_1593429869225746435]))+ &apos; month&apos;&#13;&#10;ELSEIF ISNULL(STR(DATEDIFF(&apos;month&apos;,[Siteabstractiondate],[Calculation_1593429869225746435]))) THEN &apos;Never Uploaded&apos;&#13;&#10;ELSE&#13;&#10;STR(DATEDIFF(&apos;month&apos;,[Siteabstractiondate],[Calculation_1593429869225746435])) + &apos; months&apos;&#13;&#10;END' />
      </column>
      <column caption='Max Upload Date' datatype='date' name='[Calculation_1593429869225746435]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{Fixed [DisplayMFL]: MAx([UploadDate])}' />
      </column>
      <column caption='Recency Color ' datatype='string' name='[Calculation_1593429869238980612]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1593429869216702466] = &apos;Never Uploaded&apos; OR Contains(STR(DATEDIFF(&apos;month&apos;,[Siteabstractiondate],[Calculation_1593429869225746435])),&apos;-&apos;)&#13;&#10;THEN &apos;Bad&apos;&#13;&#10;ELSEIF STR(DATEDIFF(&apos;month&apos;,[Siteabstractiondate],[Calculation_1593429869225746435])) =&apos;0&apos; &#13;&#10;OR &#13;&#10;STR(DATEDIFF(&apos;month&apos;,[Siteabstractiondate],[Calculation_1593429869225746435])) =&apos;1&apos;&#13;&#10;OR &#13;&#10;STR(DATEDIFF(&apos;month&apos;,[Siteabstractiondate],[Calculation_1593429869225746435])) =&apos;2&apos;&#13;&#10;THEN &apos;Good&apos;&#13;&#10;ELSE &apos;Average&apos; END' />
      </column>
      <column caption='Latest CT Upload' datatype='string' datatype-customized='true' name='[Calculation_1593429869476466693]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(STR({Fixed [DisplayFacilityName]: Max([UploadDate])})) THEN &apos;Never Uploaded&apos; &#13;&#10;ELSE STR({Fixed [DisplayFacilityName]: Max([UploadDate])})&#13;&#10;END' />
      </column>
      <column caption='Upload Status - Calc' datatype='string' name='[Calculation_1593429869478662153]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF STR(DATENAME(&apos;month&apos;, [Calculation_1593429869225746435]))+ &quot; &quot;+ STR(DATEPART(&apos;year&apos;, [Calculation_1593429869225746435])) = STR(DATENAME(&apos;month&apos;, [Calculation_1593429869478948874] ))+ &quot; &quot;+&#13;&#10;STR(DATEPART(&apos;year&apos;, [Calculation_1593429869478948874])) AND &#13;&#10;STR(DATENAME(&apos;month&apos;, [Calculation_1593429869225746435]))+ &quot; &quot;+ STR(DATEPART(&apos;year&apos;, [Calculation_1593429869225746435])) = STR(DATENAME(&apos;month&apos;, Today() ))+ &quot; &quot;+&#13;&#10;STR(DATEPART(&apos;year&apos;, Today()))&#13;&#10;AND &#13;&#10;STR(DATENAME(&apos;month&apos;, [Calculation_1593429869478948874]))+ &quot; &quot;+ STR(DATEPART(&apos;year&apos;, [Calculation_1593429869478948874])) = STR(DATENAME(&apos;month&apos;, Today() ))+ &quot; &quot;+&#13;&#10;STR(DATEPART(&apos;year&apos;, Today()))&#13;&#10;THEN &apos;CT &amp; PKVs Uploaded&apos;&#13;&#10;ELSEIF STR(DATENAME(&apos;month&apos;, [Calculation_1593429869225746435]))+ &quot; &quot;+ STR(DATEPART(&apos;year&apos;, [Calculation_1593429869225746435])) &lt; STR(DATENAME(&apos;month&apos;, [Calculation_1593429869478948874] ))+ &quot; &quot;+&#13;&#10;STR(DATEPART(&apos;year&apos;, [Calculation_1593429869478948874])) &#13;&#10;AND&#13;&#10;STR(DATENAME(&apos;month&apos;, [Calculation_1593429869225746435]))+ &quot; &quot;+ STR(DATEPART(&apos;year&apos;, [Calculation_1593429869225746435])) = STR(DATENAME(&apos;month&apos;, Today() ))+ &quot; &quot;+&#13;&#10;STR(DATEPART(&apos;year&apos;, Today()))&#13;&#10;THEN &apos;Latest CT Only Uploaded, PKVs Stale&apos;&#13;&#10;ELSEIF  ISNULL([Calculation_1593429869478948874]) AND NOT ISNULL([Calculation_1593429869225746435]) &#13;&#10;AND STR(DATENAME(&apos;month&apos;, [Calculation_1593429869225746435]))+ &quot; &quot;+ STR(DATEPART(&apos;year&apos;, [Calculation_1593429869225746435])) = STR(DATENAME(&apos;month&apos;, Today() ))+ &quot; &quot;+&#13;&#10;STR(DATEPART(&apos;year&apos;, Today())) THEN &apos;Only CT Uploaded; No PKVs&apos;&#13;&#10;ELSEIF  ISNULL([Calculation_1593429869225746435]) AND NOT ISNULL([Calculation_1593429869478948874]) &#13;&#10;AND&#13;&#10;STR(DATENAME(&apos;month&apos;, [Calculation_1593429869478948874]))+ &quot; &quot;+ STR(DATEPART(&apos;year&apos;, [Calculation_1593429869478948874])) = STR(DATENAME(&apos;month&apos;, Today() ))+ &quot; &quot;+&#13;&#10;STR(DATEPART(&apos;year&apos;, Today()))&#13;&#10; THEN &apos;Only PKVs Uploaded&apos;&#13;&#10;ELSEIF  ISNULL([Calculation_1593429869225746435])&#13;&#10;THEN &apos;Never Uploaded to DWH&apos;&#13;&#10;ELSE &apos;Not Uploaded this month&apos;&#13;&#10;END' />
      </column>
