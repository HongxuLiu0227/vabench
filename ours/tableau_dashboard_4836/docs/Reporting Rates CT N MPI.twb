      <column caption='Overall RR - Trend - month0' datatype='integer' hidden='true' name='[Calculation_775182133500624897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF&#13;&#10;Month([UploadDate])=month([Parameters].[Parameter 1])&#13;&#10;OR Month([UploadDate])=month([Parameters].[Parameter 1])-1&#13;&#10;OR Month([UploadDate])=month([Parameters].[Parameter 1])-2&#13;&#10;&#13;&#10;THEN&#13;&#10;inT([SiteCode])&#13;&#10;END' />
