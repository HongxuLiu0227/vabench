            <groupfilter expression='(Month([UploadDate])=Month([Parameters].[Parameter 1])&#13;&#10;AND&#13;&#10;YEAR([UploadDate])=YEAR([Parameters].[Parameter 1])&#13;&#10;OR &#13;&#10;    (Day([UploadDate])&gt;=1 AND Day([UploadDate])&lt;=5&#13;&#10;    AND Month([UploadDate])=MONTH((Dateadd(&apos;month&apos;, 1, [Parameters].[Parameter 1])))&#13;&#10;    AND Year([UploadDate])=Year([Parameters].[Parameter 1]))&#13;&#10;&#13;&#10;)&#13;&#10;OR&#13;&#10;(&#13;&#10;    DATETRUNC(&apos;month&apos;,([UploadDate]))=&#13;&#10;    DATEADD(&apos;month&apos;,-1, DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]))&#13;&#10;    OR &#13;&#10;    (Day([UploadDate])&gt;=1 AND Day([UploadDate])&lt;=5&#13;&#10;    AND Month([UploadDate])=MONTH((Dateadd(&apos;month&apos;, 0, [Parameters].[Parameter 1])))&#13;&#10;    AND Year([UploadDate])=Year([Parameters].[Parameter 1]))&#13;&#10;)&#13;&#10;OR&#13;&#10;(&#13;&#10;    DATETRUNC(&apos;month&apos;,([UploadDate]))=&#13;&#10;    DATEADD(&apos;month&apos;,-2, DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]))&#13;&#10;    OR &#13;&#10;    (&#13;&#10;    Day([UploadDate])&gt;=1 AND Day([UploadDate])&lt;=5&#13;&#10;    AND Month([UploadDate])=MONTH((Dateadd(&apos;month&apos;, -1, [Parameters].[Parameter 1])))&#13;&#10;    AND Year([UploadDate])=Year([Parameters].[Parameter 1]))&#13;&#10;)' function='filter' user:ui-marker='filter-by'>
