            <column-instance column='[Fixed Site (copy)]' derivation='User' name='[usr:Fixed Site (copy):qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <computed-sort column='[federated.0se4v9q15j8hfi17f25m50pn59wd].[none:Calculation_1593429869478662153:nk]' direction='DESC' using='[federated.0se4v9q15j8hfi17f25m50pn59wd].[usr:Fixed Site (copy):qk]' />
