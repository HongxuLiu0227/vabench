    <worksheet name='Partner: Recency'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Verdana' fontsize='11'>Overall Reporting PKVs by Partner</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontname='Verdana' fontsize='11'>&lt;[Parameters].[Parameter 1]&gt; </run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://data.kenyahmis.org/t/NASCOPCOHORT2016/workbooks/ReportingRatesCTNMPI/PartnerRecency?rev=' id='PartnerRecency' path='/t/NASCOPCOHORT2016/workbooks/ReportingRatesCTNMPI' revision='' site='NASCOPCOHORT2016' />
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (Multiple Connections)' name='federated.0se4v9q15j8hfi17f25m50pn59wd' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Upload Period - 3 Months' datatype='date' datatype-customized='true' default-format='*mmmm, yyyy' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2021-01-06#'>
              <calculation class='tableau' formula='#2021-01-06#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0se4v9q15j8hfi17f25m50pn59wd'>
            <column caption='CT Partner Denominator Expected Reports' datatype='integer' name='[County Denominator Expected Reports (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{Fixed [DisplayMechanism]:COUNTD([DisplayMFL])}' />
            </column>
            <column datatype='string' name='[DisplayAgency (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[DisplayAgency]' new-bin='true'>
                <bin default-name='false' value='&quot;CDC &quot;'>
                  <value>&quot;CDC&quot;</value>
                  <value>&quot;HHS/CDC&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Not Indicated&quot;'>
                  <value>&quot;&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[DisplayAgency]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;&quot;' value='Not Indicated' />
              </aliases>
            </column>
            <column caption='County' datatype='string' name='[DisplayCounty]' role='dimension' semantic-role='[State].[Name]' type='nominal'>
              <aliases>
                <alias key='&quot;Elegeyo-Marakwet&quot;' value='Elgeyo Marakwet' />
              </aliases>
              <semantic-values semantic-role='[State].[Name]'>
                <semantic-value key='&quot;ELEGEYO-MARAKWET&quot;' value='&quot;Elgeyo Marakwet&quot;' />
              </semantic-values>
            </column>
            <column datatype='string' name='[DisplayMFL]' role='dimension' type='nominal' />
            <column caption='Partner' datatype='string' name='[DisplayMechanism]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;AIDS HEALTH CARE FOUNDATION (AHF)&quot;' value='AHF Kenya' />
                <alias key='&quot;Aids Healthcare Foundation Kenya&quot;' value='AHF' />
                <alias key='&quot;AMREF NAIROBI KITUI&quot;' value='AMREF' />
                <alias key='&quot;BOMU HOSPITAL AFFILIATED SITES&quot;' value='BOMU' />
                <alias key='&quot;Health Communication &amp; Marketing&quot;' value='HCM' />
                <alias key='&quot;HEALTH COMMUNICATION &amp; MARKETING (HCM)&quot;' value='HEALTH COMMUNICATION &amp; MARKETING' />
                <alias key='&quot;INTEGRATED PROGRAM FOR BOTH HIV INFECTED AND AFFECTED CHILDREN AND THEIR HOUSEHOLDS&quot;' value='LEA TOTO' />
              </aliases>
            </column>
            <column datatype='string' name='[MPI_SiteCode]' role='dimension' type='nominal' />
            <column caption='Number of Sites Uploaded CT' datatype='integer' default-format='n#,##0;-#,##0' name='[NoOfPatients (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(COUNTD([SiteCode]),0)' />
            </column>
            <column caption='Number of Sites Uploaded MPI' datatype='integer' default-format='n#,##0;-#,##0' name='[Number of Sites Uploaded CT (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(COUNTD([MPI_SiteCode]),0)' />
            </column>
            <column caption='Fixed Expected Reports - ALL' datatype='integer' default-format='n#,##0;-#,##0' name='[Overview Expected EMR Sites County (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum({Fixed : COUNTD([DisplayMFL])})' />
            </column>
            <column caption='PArtner Color  MPI' datatype='string' name='[PArtner Color  (copy)]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ([Partner Percent Uploaded (copy)]&gt;=0.67)THEN &apos;Above 67%&apos;&#13;&#10;ELSEIF ([Partner Percent Uploaded (copy)]&lt;0.67 AND [Partner Percent Uploaded (copy)]&gt;=0.34)&#13;&#10; THEN &apos;34 - 66%&apos;&#13;&#10;ELSE &apos;Below 33%&apos;&#13;&#10;END' />
            </column>
            <column caption='Partner Percent Uploaded  MPI' datatype='real' default-format='p0%' name='[Partner Percent Uploaded (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Number of Sites Uploaded CT (copy)]/Sum([County Denominator Expected Reports (copy)])' />
            </column>
            <column datatype='string' name='[SiteCode]' role='dimension' type='nominal' />
            <column datatype='date' name='[UploadDate_MPI]' role='dimension' type='ordinal' />
            <column-instance column='[DisplayCounty]' derivation='None' name='[none:DisplayCounty:nk]' pivot='key' type='nominal' />
            <column-instance column='[DisplayMechanism]' derivation='None' name='[none:DisplayMechanism:nk]' pivot='key' type='nominal' />
            <column-instance column='[UploadDate_MPI]' derivation='None' name='[none:UploadDate_MPI:ok]' pivot='key' type='ordinal' />
            <column-instance column='[County Denominator Expected Reports (copy)]' derivation='Sum' name='[sum:County Denominator Expected Reports (copy):qk]' pivot='key' type='quantitative' />
            <column-instance column='[NoOfPatients (copy)]' derivation='User' name='[usr:NoOfPatients (copy):qk]' pivot='key' type='quantitative' />
            <column-instance column='[Number of Sites Uploaded CT (copy)]' derivation='User' name='[usr:Number of Sites Uploaded CT (copy):qk]' pivot='key' type='quantitative' />
            <column-instance column='[Overview Expected EMR Sites County (copy)]' derivation='User' name='[usr:Overview Expected EMR Sites County (copy):qk]' pivot='key' type='quantitative' />
            <column-instance column='[PArtner Color  (copy)]' derivation='User' name='[usr:PArtner Color  (copy):nk]' pivot='key' type='nominal' />
            <column-instance column='[Partner Percent Uploaded (copy)]' derivation='User' name='[usr:Partner Percent Uploaded (copy):qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0se4v9q15j8hfi17f25m50pn59wd].[DisplayAgency (group)]' context='true' filter-group='3'>
            <groupfilter function='level-members' level='[DisplayAgency (group)]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0se4v9q15j8hfi17f25m50pn59wd].[none:DisplayCounty:nk]' context='true' filter-group='7'>
            <groupfilter function='level-members' level='[none:DisplayCounty:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0se4v9q15j8hfi17f25m50pn59wd].[none:DisplayMechanism:nk]' context='true' filter-group='8'>
            <groupfilter function='level-members' level='[none:DisplayMechanism:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <computed-sort column='[federated.0se4v9q15j8hfi17f25m50pn59wd].[none:DisplayMechanism:nk]' direction='DESC' using='[federated.0se4v9q15j8hfi17f25m50pn59wd].[usr:Partner Percent Uploaded (copy):qk]' />
          <filter class='categorical' column='[federated.0se4v9q15j8hfi17f25m50pn59wd].[none:UploadDate_MPI:ok]'>
            <groupfilter expression='Month([UploadDate_MPI])=Month([Parameters].[Parameter 1])&#13;&#10;AND Year([UploadDate_MPI])=Year([Parameters].[Parameter 1])&#13;&#10;OR&#13;&#10;(Day([UploadDate_MPI])&gt;=1 AND Day([UploadDate_MPI])&lt;=5&#13;&#10;AND Month([UploadDate_MPI])=MONTH((Dateadd(&apos;month&apos;, 1, [Parameters].[Parameter 1])))&#13;&#10;AND Year([UploadDate_MPI])=Year([Parameters].[Parameter 1]))' function='filter' user:ui-marker='filter-by'>
              <groupfilter function='level-members' level='[none:UploadDate_MPI:ok]' user:ui-enumeration='all' user:ui-marker='enumerate' />
            </groupfilter>
          </filter>
          <manual-sort column='[federated.0se4v9q15j8hfi17f25m50pn59wd].[usr:PArtner Color  (copy):nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Above 67\%&quot;</bucket>
              <bucket>&quot;34 - 66\%&quot;</bucket>
              <bucket>&quot;Below 33\%&quot;</bucket>
              <bucket>%all%</bucket>
            </dictionary>
          </manual-sort>
          <slices>
            <column>[federated.0se4v9q15j8hfi17f25m50pn59wd].[DisplayAgency (group)]</column>
            <column>[federated.0se4v9q15j8hfi17f25m50pn59wd].[none:DisplayCounty:nk]</column>
            <column>[federated.0se4v9q15j8hfi17f25m50pn59wd].[none:DisplayMechanism:nk]</column>
            <column>[federated.0se4v9q15j8hfi17f25m50pn59wd].[none:UploadDate_MPI:ok]</column>
          </slices>
          <aggregation value='true' />
        </view>
