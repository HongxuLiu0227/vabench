          <zone _.fcp.SetMembershipControl.false...type='text' _.fcp.SetMembershipControl.true...type-v2='text' forceUpdate='true' h='30061' id='18' w='33629' x='527' y='69770'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Tableau Regular' fontsize='10' underline='true'>Definitions</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='10'>EMR Recency Date</run>
              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='11'>Æ </run>
              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='10'>is an indicator of when the EMR was last updated. If the date is 4 months ago, it either means that that’s the last time a facility had a patient, or the last time the EMR was updated.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='10'>Latest Upload Date</run>
              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='10'>: Is the last time the EMR was uploaded to the DWH</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='10'>Latest PKV Date</run>
              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='10'>: Is the last time the PKVs were uploaded to the DWH</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#20dcb3' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
          </zone-style>
        </zone>
