              </semantic-values>
            </column>
            <column caption='Facility Name' datatype='string' name='[DisplayFacilityName]' role='dimension' type='nominal' />
            <column datatype='string' name='[DisplayMFL]' role='dimension' type='nominal' />
            <column caption='Partner' datatype='string' name='[DisplayMechanism]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;AIDS HEALTH CARE FOUNDATION (AHF)&quot;' value='AHF Kenya' />
                <alias key='&quot;Aids Healthcare Foundation Kenya&quot;' value='AHF' />
                <alias key='&quot;AMREF NAIROBI KITUI&quot;' value='AMREF' />
                <alias key='&quot;BOMU HOSPITAL AFFILIATED SITES&quot;' value='BOMU' />
                <alias key='&quot;Health Communication &amp; Marketing&quot;' value='HCM' />
                <alias key='&quot;HEALTH COMMUNICATION &amp; MARKETING (HCM)&quot;' value='HEALTH COMMUNICATION &amp; MARKETING' />
                <alias key='&quot;INTEGRATED PROGRAM FOR BOTH HIV INFECTED AND AFFECTED CHILDREN AND THEIR HOUSEHOLDS&quot;' value='LEA TOTO' />
              </aliases>
            </column>
            <column caption='Number EMR Sites' datatype='integer' name='[Fixed Site (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CountD([DisplayMFL])' />
            </column>
            <column caption='Upload Date' datatype='date' name='[UploadDate]' role='dimension' type='ordinal' />
            <column datatype='date' name='[UploadDate_MPI]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1593429869478662153]' derivation='None' name='[none:Calculation_1593429869478662153:nk]' pivot='key' type='nominal' />
            <column-instance column='[DisplayCounty]' derivation='None' name='[none:DisplayCounty:nk]' pivot='key' type='nominal' />
            <column-instance column='[DisplayFacilityName]' derivation='None' name='[none:DisplayFacilityName:nk]' pivot='key' type='nominal' />
