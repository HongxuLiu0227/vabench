        <calculation class='tableau' formula='Month([Parameters].[Parameter 1])' />
      </column>
      <column caption='Months' datatype='integer' hidden='true' name='[Calculation_1116892761630998552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Case Month([Parameters].[Parameter 1])&#13;&#10;WHEN Month([Parameters].[Parameter 1]) THEN&#13;&#10;COUNTD([Calculation_775182133500624897])&#13;&#10;WHEN Month([Parameters].[Parameter 1])-1 THEN&#13;&#10;COUNTD([Overall RR - Trend - month 0 (copy)])&#13;&#10;END' />
      </column>
      <column caption='Month uploaded 3 Months' datatype='integer' hidden='true' name='[Calculation_1116892761645535257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED  &#13;&#10;Month([UploadDate])=month([Parameters].[Parameter 1]) OR Month([UploadDate])=month([Parameters].[Parameter 1])-1&#13;&#10;OR Month([UploadDate])=month([Parameters].[Parameter 1])-2&#13;&#10;:COUNTD([SiteCode])}' />
      </column>
