      <column caption='Last 3 Months Label' datatype='string' name='[Calculation_977562619923836938]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DateName(&apos;month&apos;,DATEADD(&apos;month&apos;,-3,Today()))) + &quot; &quot;+  STR(YEar(DATEADD(&apos;month&apos;,0,Today()))) &#13;&#10;&#13;&#10;+ &quot; to &quot;+ STR(DateName(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,Today()))) + &quot; &quot;+  STR(YEar(DATEADD(&apos;month&apos;,0,Today())))' />
      </column>
      <column caption='Percent EMR Sites' datatype='real' default-format='p0%' hidden='true' name='[Calculation_977562620856627212]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1308014242145460225]/Sum([Calculation_714102023265128449])' />
      </column>
      <column caption='number cou' datatype='integer' hidden='true' name='[Calculation_977562620857430029]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CountD([DisplayCounty])' />
      </column>
      <column caption='Variable 3' datatype='boolean' hidden='true' name='[Calculation_977562620908834846]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRUE' />
      </column>
      <column caption='Upload Month Year - consistency' datatype='date' datatype-customized='true' default-format='*mmmm yyyy' name='[Calculation_989947529004945410]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;HHmm-MM-dd yyyy&quot;, IF Month([UploadDate])=Month([Parameters].[Parameter 1]) AND Year([UploadDate])=Year([Parameters].[Parameter 1])&#13;&#10;OR (Day([UploadDate])&gt;=1 AND Day([UploadDate])&lt;=5 AND Month([UploadDate])=MONTH((Dateadd(&apos;month&apos;, 1, [Parameters].[Parameter 1])))&#13;&#10;AND Year([UploadDate])=Year([Parameters].[Parameter 1])) THEN STR(DATEADD(&apos;month&apos;,0, DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])))+ &quot; &quot;+ STR(DATEPART(&apos;year&apos;, [Parameters].[Parameter 1]))&#13;&#10;&#13;&#10;ELSEIF (DATETRUNC(&apos;month&apos;,([UploadDate]))= DATEADD(&apos;month&apos;,-1, DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]))&#13;&#10;OR (Day([UploadDate])&gt;=1 AND Day([UploadDate])&lt;=5&#13;&#10;AND Month([UploadDate])=MONTH((Dateadd(&apos;month&apos;, 0, [Parameters].[Parameter 1])))&#13;&#10;AND Year([UploadDate])=Year([Parameters].[Parameter 1]))&#13;&#10;)&#13;&#10;THEN STR(DATEADD(&apos;month&apos;,-1, DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])))+ &quot; &quot;+ STR(DATEPART(&apos;year&apos;, [Parameters].[Parameter 1]))&#13;&#10;&#13;&#10;ELSEIF(&#13;&#10;DATETRUNC(&apos;month&apos;,([UploadDate]))=&#13;&#10;DATEADD(&apos;month&apos;,-2, DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])&#13;&#10;)&#13;&#10;OR &#13;&#10;(Day([UploadDate])&gt;=1 AND Day([UploadDate])&lt;=5&#13;&#10;AND Month([UploadDate])=MONTH((Dateadd(&apos;month&apos;, -1, [Parameters].[Parameter 1])))&#13;&#10;AND Year([UploadDate])=Year([Parameters].[Parameter 1]))&#13;&#10;)&#13;&#10;THEN STR(DATEADD(&apos;month&apos;,-2, DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])))+ &quot; &quot;+ STR(DATEPART(&apos;year&apos;, [Parameters].[Parameter 1]))&#13;&#10; END )) ' />
      </column>
      <column caption='Consistency at Site Level' datatype='string' hidden='true' name='[Consistency (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF {Fixed [DisplayMechanism],[UploadDate],[SiteCode]: Count([SiteCode])}&#13;&#10;%3 = 0 THEN &apos;Concist&apos; ELSE &apos;NO&apos; END' />
      </column>
      <column caption='County -test' datatype='string' hidden='true' name='[County - Uploads Score (copy)]' role='measure' semantic-role='[County].[Name]' type='nominal'>
        <calculation class='tableau' formula='IF  [Calculation_714102023265861635] &gt;=0.67 THEN &apos;Good&apos;&#13;&#10;ELSEIF  [Calculation_714102023265861635]&gt;=0.34 AND [Calculation_714102023265861635]&lt;0.67 &#13;&#10;THEN &apos;Average&apos;&#13;&#10;ELSE &apos;Bad&apos; END' />
      </column>
      <column caption='County Color MPI' datatype='string' name='[County Color (copy 2)]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ([County Percent Uploads Proportions (copy 3)]&gt;=0.67)THEN &apos;Above 67%&apos;&#13;&#10;ELSEIF ([County Percent Uploads Proportions (copy 3)]&lt;0.67 &#13;&#10;AND [County Percent Uploads Proportions (copy 3)]&gt;=0.34)&#13;&#10; THEN &apos;34 - 66%&apos;&#13;&#10;ELSE &apos;Below 34%&apos;&#13;&#10;END' />
      </column>
      <column caption='PArtner Color ' datatype='string' name='[County Color (copy)]' role='measure' semantic-role='[County].[Name]' type='nominal'>
        <calculation class='tableau' formula='IF ([County Percent Uploads Proportions (copy)]&gt;=0.67)THEN &apos;Above 67%&apos;&#13;&#10;ELSEIF ([County Percent Uploads Proportions (copy)]&lt;0.67 AND [County Percent Uploads Proportions (copy)]&gt;=0.34)&#13;&#10; THEN &apos;34 - 66%&apos;&#13;&#10;ELSE &apos;Below 33%&apos;&#13;&#10;END' />
      </column>
      <column caption='Overview  Denominator Expected Reports' datatype='integer' name='[County Denominator Expected Reports (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{Fixed:COUNTD([DisplayMFL])}' />
