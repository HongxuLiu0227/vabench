                </bin>
                <bin default-name='false' value='&quot;LEA TOTO&quot;'>
                  <value>&quot;INTEGRATED PROGRAM FOR BOTH HIV INFECTED AND AFFECTED CHILDREN AND THEIR HOUSEHOLDS&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;WRP SOUTH-RIFT&quot;'>
                  <value>&quot;WRP SOUTH RIFT&quot;</value>
                  <value>&quot;WRP-SOUTH RIFT&quot;</value>
                </bin>
