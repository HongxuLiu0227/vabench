      <column datatype='integer' hidden='true' name='[Overall (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF Month([UploadDate])= Month([Parameters].[Parameter 1]) OR &#13;&#10;Month([UploadDate])= Month([Parameters].[Parameter 1])-1 OR&#13;&#10;Month([UploadDate])= Month([Parameters].[Parameter 1])-2&#13;&#10;THEN int([SiteCode]) &#13;&#10;&#13;&#10;&#13;&#10;ELSEIF Month([UploadDate])= Month([Parameters].[Parameter 1])-1 OR &#13;&#10;Month([UploadDate])= Month([Parameters].[Parameter 1])-2 OR&#13;&#10;Month([UploadDate])= Month([Parameters].[Parameter 1])-3&#13;&#10;THEN int([SiteCode]) &#13;&#10;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Most recent month - Overall' datatype='boolean' hidden='true' name='[Overall RR - Trend - month 0 (copy 2)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Month([UploadDate])= Month(Today())-1 OR &#13;&#10;Month([UploadDate])= Month(Today())-2 OR&#13;&#10;Month([UploadDate])= Month(Today())-3' />
      </column>
      <column caption='Overall RR - Trend - month1' datatype='integer' hidden='true' name='[Overall RR - Trend - month 0 (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF Month([UploadDate])= Month([Parameters].[Parameter 1])-1 OR&#13;&#10;Month([UploadDate])= Month([Parameters].[Parameter 1])-2 OR&#13;&#10;Month([UploadDate])= Month([Parameters].[Parameter 1])-3&#13;&#10;THEN Int([SiteCode])&#13;&#10; &#13;&#10;END' />
      </column>
      <column caption='Consistency' datatype='string' hidden='true' name='[Overall RR - Trend - month0 (copy)]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNT([Consistency (copy)])&gt;=3 THEN &quot;Consistent&quot; ELSE &quot;Nope&quot; END' />
      </column>
      <column caption='3 Month Duration' datatype='boolean' hidden='true' name='[Overall RR - Trend - month1 (copy 2)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Month([UploadDate])=Month([Parameters].[Parameter 1])&#13;&#10;OR&#13;&#10;Month([UploadDate])=Month([Parameters].[Parameter 1])-1&#13;&#10;OR&#13;&#10;Month([UploadDate])=Month([Parameters].[Parameter 1])-2' />
      </column>
      <column caption='Overall RR - Trend - month2' datatype='integer' hidden='true' name='[Overall RR - Trend - month1 (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF Month([UploadDate])= Month([Parameters].[Parameter 1])-2 OR&#13;&#10;Month([UploadDate])= Month([Parameters].[Parameter 1])-3 OR&#13;&#10;Month([UploadDate])= Month([Parameters].[Parameter 1])-4&#13;&#10;THEN Int([SiteCode])&#13;&#10; &#13;&#10;END' />
      </column>
      <column caption='Overall RR - Trend - month3' datatype='integer' hidden='true' name='[Overall RR - Trend - month2 (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF Month([UploadDate])= Month([Parameters].[Parameter 1])-3 OR&#13;&#10;Month([UploadDate])= Month([Parameters].[Parameter 1])-4 OR&#13;&#10;Month([UploadDate])= Month([Parameters].[Parameter 1])-5&#13;&#10;THEN Int([SiteCode])&#13;&#10; &#13;&#10;END' />
      </column>
      <column caption='Recency Reporting Rate' datatype='string' hidden='true' name='[Overall reporting Rate (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF (Month([UploadDate])=Month([Parameters].[Parameter 1])&#13;&#10;) THEN [DisplayFacilityName] END' />
      </column>
      <column caption='Fixed Expected Reports - ALL' datatype='integer' default-format='n#,##0;-#,##0' name='[Overview Expected EMR Sites County (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum({Fixed : COUNTD([DisplayMFL])})' />
