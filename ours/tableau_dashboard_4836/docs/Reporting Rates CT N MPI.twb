            <column caption='Number of Sites Uploaded CT' datatype='integer' default-format='n#,##0;-#,##0' name='[NoOfPatients (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(COUNTD([SiteCode]),0)' />
