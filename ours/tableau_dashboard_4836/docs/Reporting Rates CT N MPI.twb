    <worksheet name='County: PKV Recency'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Verdana' fontsize='11'>Overall Reporting - PKVs by County</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontname='Verdana' fontsize='11'>&lt;[Parameters].[Parameter 1]&gt; </run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://data.kenyahmis.org/t/NASCOPCOHORT2016/workbooks/ReportingRatesCTNMPI/CountyPKVRecency?rev=' id='CountyPKVRecency' path='/t/NASCOPCOHORT2016/workbooks/ReportingRatesCTNMPI' revision='' site='NASCOPCOHORT2016' />
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (Multiple Connections)' name='federated.0se4v9q15j8hfi17f25m50pn59wd' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Upload Period - 3 Months' datatype='date' datatype-customized='true' default-format='*mmmm, yyyy' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2021-01-06#'>
              <calculation class='tableau' formula='#2021-01-06#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0se4v9q15j8hfi17f25m50pn59wd'>
            <column caption='County Color' datatype='string' name='[Calculation_557601975853465601]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ([Calculation_714102023265861635]&gt;=0.67)THEN &apos;Above 67%&apos;&#13;&#10;ELSEIF ([Calculation_714102023265861635]&lt;0.67 AND [Calculation_714102023265861635]&gt;=0.34)&#13;&#10; THEN &apos;34 - 66%&apos;&#13;&#10;ELSE &apos;Below 34%&apos;&#13;&#10;END' />
            </column>
            <column caption='County Denominator Expected Reports' datatype='integer' name='[Calculation_714102023265128449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{Fixed [DisplayCounty]:COUNTD([DisplayMFL])}' />
            </column>
            <column caption='County Percent Uploads Proportions' datatype='real' default-format='p0%' name='[Calculation_714102023265861635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[NoOfPatients (copy)]/Sum([Calculation_714102023265128449])' />
            </column>
            <column caption='County Color MPI' datatype='string' name='[County Color (copy 2)]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ([County Percent Uploads Proportions (copy 3)]&gt;=0.67)THEN &apos;Above 67%&apos;&#13;&#10;ELSEIF ([County Percent Uploads Proportions (copy 3)]&lt;0.67 &#13;&#10;AND [County Percent Uploads Proportions (copy 3)]&gt;=0.34)&#13;&#10; THEN &apos;34 - 66%&apos;&#13;&#10;ELSE &apos;Below 34%&apos;&#13;&#10;END' />
            </column>
