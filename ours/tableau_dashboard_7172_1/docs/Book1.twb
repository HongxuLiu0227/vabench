      <aliases enabled="yes" />
      <column datatype="string" name="[Boat Condition]" role="dimension" type="nominal" />
      <column caption="Boat Price Cut Date" datatype="date" name="[Boat_Price_Cut_Date]" role="dimension" type="ordinal" />
      <column caption="Boat Sold Date" datatype="date" name="[Boat_Sold_Date]" role="dimension" type="ordinal" />
      <column caption="Buyer Email" datatype="string" name="[BuyerEmail]" role="dimension" type="nominal" />
      <column caption="Price Cut Percent" datatype="real" name="[Calculation_1106478137490472960]" role="measure" type="quantitative">
        <calculation class="tableau" formula="-([Listing Price] - [Price Was])/[Price Was]" />
      </column>
      <column caption="DaysBoughtAfterPriceCut" datatype="integer" name="[Calculation_1145603158923091968]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[Boat_Sold_Date]-[Boat_Price_Cut_Date]" />
      </column>
      <column caption="DaysBoughtAfterListing" datatype="integer" name="[Calculation_1145603158940704770]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[Boat_Sold_Date]-[Listing Date]" />
      </column>
      <column caption="HasPriceCut" datatype="boolean" name="[Calculation_1145603158979420163]" role="dimension" type="nominal">
        <calculation class="tableau" formula="not isnull([Boat_Price_Cut_Date])" />
        <aliases>
          <alias key="false" value="No Price Cut" />
          <alias key="true" value="Price Cut" />
        </aliases>
      </column>
      <column caption="SoldAtPercentofListing" datatype="real" name="[Calculation_1145603158995693572]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[Sold Price - Split 2]/[Listing Price]" />
      </column>
      <column caption="DaysUntilPriceCut" datatype="integer" name="[Calculation_1180787531334811648]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[Listing Date]-[Boat_Sold_Date]" />
