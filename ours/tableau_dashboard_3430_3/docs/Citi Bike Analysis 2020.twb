      <column caption="Seasons" datatype="string" name="[Calculation_949696574838284288]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF MONTH([starttime])=12 OR MONTH([starttime])=1 OR MONTH([starttime])=2 THEN 'Winter'&#13;&#10;&#13;&#10;ELSEIF MONTH([starttime])=6 OR MONTH([starttime])=7 OR MONTH([starttime])=8 THEN 'Summer'&#13;&#10;&#13;&#10;END" />
      </column>
      <column caption="Summer Seasons" datatype="string" name="[Calculation_949696574839951361]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF (MONTH([starttime])=6) OR (MONTH([starttime])=7) OR (MONTH([starttime])=8) THEN 'Summer'&#13;&#10;&#13;&#10;END" />
      </column>
      <column aggregation="Sum" caption="Age" datatype="integer" name="[Calculation_949696574842662915]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="2021 - YEAR([birth year])" />
      </column>
      <column caption="Bottom 10 Filter" datatype="boolean" name="[Calculation_949696574854787079]" role="measure" type="nominal">
