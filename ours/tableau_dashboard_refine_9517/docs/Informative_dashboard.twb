      <aliases enabled='yes' />
      <column caption='info' datatype='string' name='[Calculation_1941051468927434752]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;&apos;&apos;&apos;' />
      </column>
      <column caption='Top 10 Product' datatype='string' name='[Calculation_317222333014716416]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Sub-Category Set] then [Product Name] else &apos;&apos; end' />
      </column>
      <column caption='Profit Ratio' datatype='real' default-format='p0%' name='[Calculation_5571209093911105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' scope-isolation='false' />
      </column>
